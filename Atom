        "def extract_clean_checkpoint(job_id, save_name=\"aria_clean_checkpoint.json\"):\n",
        "    backend_aria = provider.get_backend(\"qpu.aria-1\")\n",
        "    job = backend_aria.retrieve_job(job_id)\n",
        "    status = job.status().name\n",
        "\n",
        "    if status != \"DONE\":\n",
        "        print(f\"Job {job_id} is not ready. Current status: {status}\")\n",
        "        return None\n",
        "\n",
        "    result = job.result()\n",
        "    probabilities = result.get_probabilities()\n",
        "\n",
        "    # Filter: Keep only states above a 0.5% detection threshold to drop noise bloat\n",
        "    filtered_probs = {\n",
        "        state: round(prob, 5)\n",
        "        for state, prob in probabilities.items()\n",
        "        if prob > 0.005\n",
        "    }\n",
        "\n",
        "    # Package strictly what downstream cells need\n",
        "    checkpoint_data = {\n",
        "        \"job_id\": job_id,\n",
        "        \"source_target\": \"aria-1\",\n",
        "        \"shots\": result.results[0].shots if hasattr(result, \"results\") else None,\n",
        "        \"filtered_probabilities\": filtered_probs,\n",
        "        \"top_state\": max(filtered_probs, key=filtered_probs.get),\n",
        "    }\n",
        "\n",
        "    checkpoint_path = f\"/content/drive/MyDrive/{save_name}\"\n",
        "    with open(checkpoint_path, \"w\") as f:\n",
        "        json.dump(checkpoint_data, f, indent=2)\n",
        "\n",
        "    print(f\"Filtered checkpoint stored at: {checkpoint_path}\")\n",
        "    return checkpoint_data\n"
