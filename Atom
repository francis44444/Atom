        "import matplotlib.pyplot as plt\n",
        "from qiskit import QuantumCircuit, transpile\n",
        "from qiskit_aer import AerSimulator\n",
        "from qiskit_aer.noise import NoiseModel, depolarizing_error\n",
        "\n",
        "# --- 1. Helper Functions (Ensuring dependencies are local) ---\n",
        "def build_bell_baseline():\n",
        "    qc = QuantumCircuit(2, 2)\n",
        "    qc.h(0)\n",
        "    qc.cx(0, 1)\n",
        "    qc.measure([0, 1], [0, 1])\n",
        "    return qc\n",
        "\n",
        "def analyze_counts_local(counts, shots=1024):\n",
        "    parity_error = sum(v for k, v in counts.items() if bin(int(k, 2)).count('1') % 2 != 0) / shots\n",
        "    bell_fidelity = (counts.get('00', 0) + counts.get('11', 0)) / shots\n",
        "    return {'parity_error_rate': parity_error, 'bell_fidelity_proxy': bell_fidelity}\n",
        "\n",
        "def build_noise_model(p1):\n",
        "    noise = NoiseModel()\n",
        "    p2 = p1 * 5.0\n",
        "    noise.add_all_qubit_quantum_error(depolarizing_error(p1, 1), ['h', 'x', 'sx', 'rz', 'ry', 'rx'])\n",
        "    noise.add_all_qubit_quantum_error(depolarizing_error(p2, 2), ['cx', 'cz'])\n",
        "    return noise\n",
        "\n",
        "# --- 2. Data Generation ---\n",
        "# Broad Synthetic Sweep\n",
        "synthetic_p1_values = [0.0001, 0.001, 0.005, 0.01, 0.02, 0.05]\n",
        "sensitivity_sweep_results = []\n",
        "for p1_val in synthetic_p1_values:\n",
        "    sim = AerSimulator(noise_model=build_noise_model(p1_val))\n",
        "    qc = build_bell_baseline()\n",
        "    counts = sim.run(transpile(qc, sim), shots=1024).result().get_counts()\n",
        "    analysis = analyze_counts_local(counts, shots=1024)\n",
        "    sensitivity_sweep_results.append({'p1': p1_val, 'analysis': analysis})\n",
        "\n",
        "# Forte Targeted Sweep (if forte_sensitivity_sweep_results is missing, we recreate it here)\n",
        "if 'forte_sensitivity_sweep_results' not in globals():\n",
        "    forte_p1_values = [0.0001, 0.0003, 0.0005, 0.0007, 0.0010]\n",
        "    forte_sensitivity_sweep_results = []\n",
        "    for p1_val in forte_p1_values:\n",
        "        sim = AerSimulator(noise_model=build_noise_model(p1_val))\n",
        "        qc = build_bell_baseline()\n",
        "        counts = sim.run(transpile(qc, sim), shots=8192).result().get_counts()\n",
        "        analysis = analyze_counts_local(counts, shots=8192)\n",
        "        forte_sensitivity_sweep_results.append({'p1': p1_val, 'analysis': analysis})\n",
        "\n",
        "# --- 3. Visualization ---\n",
        "# Extract synthetic data\n",
        "p1_synthetic = [res['p1'] for res in sensitivity_sweep_results]\n",
        "bell_synthetic = [res['analysis']['bell_fidelity_proxy'] for res in sensitivity_sweep_results]\n",
        "parity_synthetic = [res['analysis']['parity_error_rate'] for res in sensitivity_sweep_results]\n",
        "\n",
        "# Extract Forte data\n",
        "p1_forte = [res['p1'] for res in forte_sensitivity_sweep_results]\n",
        "bell_forte = [res['analysis']['bell_fidelity_proxy'] for res in forte_sensitivity_sweep_results]\n",
        "parity_forte = [res['analysis']['parity_error_rate'] for res in forte_sensitivity_sweep_results]\n",
        "\n",
        "plt.figure(figsize=(14, 6))\n",
        "\n",
        "# Subplot 1: Bell Fidelity Comparison\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.plot(p1_synthetic, bell_synthetic, marker='o', linestyle='-', color='lightgray', label='Synthetic Sweep (Broad)')\n",
        "plt.plot(p1_forte, bell_forte, marker='s', linestyle='-', color='dodgerblue', label='Forte Simulator Profile')\n",
        "plt.title('Bell Fidelity Comparison')\n",
        "plt.xlabel('Single-Qubit Infidelity (p1)')\n",
        "plt.ylabel('Bell Fidelity')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "\n",
        "# Subplot 2: Parity Error Comparison\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.plot(p1_synthetic, parity_synthetic, marker='x', linestyle='--', color='lightgray', label='Synthetic Sweep (Broad)')\n",
        "plt.plot(p1_forte, parity_forte, marker='^', linestyle='--', color='crimson', label='Forte Simulator Profile')\n",
        "plt.title('Parity Error Comparison')\n",
        "plt.xlabel('Single-Qubit Infidelity (p1)')\n",
        "plt.ylabel('Parity Error Rate')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
