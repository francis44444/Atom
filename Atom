        "import pennylane as qml\n",
        "from pennylane import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. SETUP: Configuration and Device\n",
        "# Change 'noise_probability' to 0.01 to see the Stability Zone expand!\n",
        "noise_probability = 0.05\n",
        "dev_mixed = qml.device('default.mixed', wires=4)\n",
        "\n",
        "# 2. THE ENGINE: Noisy Quantum Circuit\n",
        "@qml.qnode(dev_mixed)\n",
        "def run_noisy_quantum_audit(p_noise):\n",
        "    # State Preparation (The 'qc' logic)\n",
        "    qml.Hadamard(wires=0)\n",
        "    qml.CNOT(wires=[0, 1])\n",
        "    qml.RY(0.3, wires=2)\n",
        "    qml.RX(0.1, wires=3)\n",
        "\n",
        "    # Injecting Environmental Noise\n",
        "    for i in range(4):\n",
        "        qml.DepolarizingChannel(p_noise, wires=i)\n",
        "\n",
        "    return qml.density_matrix(wires=[0, 1, 2, 3])\n",
        "\n",
        "# 3. THE AUDIT: Data Processing\n",
        "rho_final = run_noisy_quantum_audit(noise_probability)\n",
        "layers_map = [([0, 1], 'Nucleus'), ([2], 'Electron Cloud'), ([3], 'Vacuum Field')]\n",
        "audit_results = []\n",
        "\n",
        "for wires, name in layers_map:\n",
        "    # Calculate Entropy (S)\n",
        "    s_val = float(qml.math.vn_entropy(rho_final, indices=wires))\n",
        "    # Calculate Purity (P)\n",
        "    rho_sub = qml.math.reduce_dm(rho_final, indices=wires)\n",
        "    p_val = float(np.real(np.trace(np.matmul(rho_sub, rho_sub))))\n",
        "    # Calculate Stability (St = P - S)\n",
        "    st_val = max(0, p_val - s_val)\n",
        "\n",
        "    audit_results.append({'layer': name, 'purity': p_val, 'entropy': s_val, 'stability': st_val})\n",
        "\n",
        "df_audit = pd.DataFrame(audit_results)\n",
        "\n",
        "# 4. THE DASHBOARD: Visualization\n",
        "fig, axes = plt.subplots(1, 3, figsize=(22, 6))\n",
        "\n",
