        "\n",
        "def normalize_counts(counts):\n",
        "\n",
        "    cleaned = {}\n",
        "\n",
        "    for key, value in counts.items():\n",
        "\n",
        "        key = str(key).replace(\n",
        "            \" \",\n",
        "            \"\"\n",
        "        )\n",
        "\n",
        "        cleaned[key] = (\n",
        "            cleaned.get(key, 0)\n",
        "            + int(value)\n",
        "        )\n",
        "\n",
        "    return cleaned\n",
        "\n",
        "\n",
        "def expectation_zz(counts):\n",
        "\n",
        "    counts = normalize_counts(\n",
        "        counts\n",
        "    )\n",
        "\n",
        "    total = sum(\n",
        "        counts.values()\n",
        "    )\n",
        "\n",
        "    if total == 0:\n",
        "        return float(\"nan\")\n",
        "\n",
        "    return (\n",
        "        counts.get(\"00\", 0)\n",
        "        + counts.get(\"11\", 0)\n",
        "        - counts.get(\"01\", 0)\n",
        "        - counts.get(\"10\", 0)\n",
        "    ) / total\n",
        "\n",
        "\n",
        "def bell_z_support(counts):\n",
        "\n",
        "    counts = normalize_counts(\n",
        "        counts\n",
        "    )\n",
        "\n",
        "    total = sum(\n",
        "        counts.values()\n",
        "    )\n",
        "\n",
        "    if total == 0:\n",
        "        return float(\"nan\")\n",
        "\n",
        "    return (\n",
        "        counts.get(\"00\", 0)\n",
        "        + counts.get(\"11\", 0)\n",
        "    ) / total\n",
        "\n",
        "\n",
        "def parity_error(counts):\n",
        "\n",
        "    counts = normalize_counts(\n",
        "        counts\n",
        "    )\n",
        "\n",
        "    total = sum(\n",
        "        counts.values()\n",
        "    )\n",
        "\n",
        "    if total == 0:\n",
        "        return float(\"nan\")\n",
        "\n",
        "    return (\n",
        "        counts.get(\"01\", 0)\n",
        "        + counts.get(\"10\", 0)\n",
        "    ) / total\n",
        "\n",
        "\n",
        "def expectation_from_counts(counts):\n",
        "\n",
        "    return expectation_zz(\n",
        "        counts\n",
        "    )\n",
        "\n",
        "\n",
        "def calculate_chsh(\n",
        "    results\n",
        "):\n",
        "\n",
        "    required = [\n",
        "        \"A0_B0\",\n",
        "        \"A0_B1\",\n",
        "        \"A1_B0\",\n",
        "        \"A1_B1\",\n",
        "    ]\n",
        "\n",
        "    missing = [\n",
        "        name\n",
        "        for name in required\n",
        "        if name not in results\n",
        "    ]\n",
        "\n",
        "    if missing:\n",
        "\n",
        "        raise ValueError(\n",
        "            f\"Missing CHSH settings: {missing}\"\n",
        "        )\n",
        "\n",
        "    correlations = {}\n",
        "\n",
        "    for name in required:\n",
        "\n",
        "        correlations[name] = (\n",
        "            expectation_from_counts(\n",
        "                results[name][\"counts\"]\n",
        "            )\n",
        "        )\n",
        "\n",
        "    S = (\n",
        "        correlations[\"A0_B0\"]\n",
        "        + correlations[\"A0_B1\"]\n",
        "        + correlations[\"A1_B0\"]\n",
        "        - correlations[\"A1_B1\"]\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"correlations\": correlations,\n",
        "        \"S\": S,\n",
        "        \"classical_bound\": 2.0,\n",
        "        \"quantum_tsirelson_bound\": 2.0 * math.sqrt(2),\n",
        "        \"bell_violation\": abs(S) > 2.0,\n",
        "    }\n",
