        "\n",
        "from qiskit import QuantumCircuit, transpile\n",
        "from qiskit_aer import AerSimulator\n",
        "from qiskit_aer.noise import NoiseModel, depolarizing_error\n",
        "\n",
        "SHOTS = 1024\n",
        "\n",
        "def analyze_counts_local(counts, shots=1024):\n",
        "    probs = {k: v / shots for k, v in counts.items()}\n",
        "    zz = sum((v / shots) * (1 if bin(int(k, 2)).count(\"1\") % 2 == 0 else -1) for k, v in counts.items())\n",
        "    parity_error = sum(v for k, v in counts.items() if bin(int(k, 2)).count(\"1\") % 2 != 0) / shots\n",
        "    bell_fidelity = (counts.get(\"00\", 0) + counts.get(\"11\", 0)) / shots\n",
        "    return {\"probabilities\": probs, \"expectation_ZZ\": zz, \"parity_error_rate\": parity_error, \"bell_fidelity_proxy\": bell_fidelity}\n",
        "\n",
        "def build_bell_baseline():\n",
        "    qc = QuantumCircuit(2, 2, name=\"Bell_Baseline\")\n",
        "    qc.h(0)\n",
        "    qc.cx(0, 1)\n",
        "    qc.measure([0, 1], [0, 1])\n",
        "    return qc\n",
        "\n",
        "def build_variable_noise_model(one_qubit_error_rate):\n",
        "    noise = NoiseModel()\n",
        "    two_qubit_error_rate = one_qubit_error_rate * 5.0\n",
        "    noise.add_all_qubit_quantum_error(depolarizing_error(one_qubit_error_rate, 1), [\"h\", \"x\", \"y\", \"z\", \"rx\", \"ry\", \"rz\", \"sx\"])\n",
        "    noise.add_all_qubit_quantum_error(depolarizing_error(two_qubit_error_rate, 2), [\"cx\"])\n",
        "    return noise\n",
        "\n",
        "def run_noise_sensitivity_sweep(circuit, p1_error_rates, shots=SHOTS):\n",
        "    sweep_results = []\n",
        "    print(\"\\n--- Running Noise Sensitivity Sweep ---\")\n",
        "    for p1 in p1_error_rates:\n",
        "        print(f\"  • Simulating with 1Q error = {p1:.5f}...\")\n",
        "        simulator = AerSimulator(noise_model=build_variable_noise_model(p1))\n",
        "        compiled = transpile(circuit, simulator, optimization_level=1)\n",
        "        job = simulator.run(compiled, shots=shots, memory=True)\n",
        "        counts = job.result().get_counts()\n",
        "        sweep_results.append({\n",
        "            \"p1_error_rate\": p1,\n",
        "            \"counts\": counts,\n",
        "            \"analysis\": analyze_counts_local(counts, shots=shots)\n",
