        "    \"\"\"\n",
        "    Computes exact FCI and VQE ground state energy in a genuine CAS(4,4) active space.\n",
        "    4 active electrons in 4 spatial active orbitals -> 8 spin-qubits mapped via Jordan-Wigner.\n",
        "    \"\"\"\n",
        "    print(\"--- Setting up CAS(4,4) Molecular Hamiltonian ---\")\n",
        "    driver = PySCFDriver(atom=atom_geometry, basis=basis)\n",
        "    raw_problem = driver.run()\n",
        "\n",
        "    # Define Active Space: 4 electrons, 4 spatial orbitals\n",
        "    transformer = ActiveSpaceTransformer(num_electrons=4, num_spatial_orbitals=4)\n",
        "    problem = transformer.transform(raw_problem)\n",
        "\n",
        "    mapper = JordanWignerMapper()\n",
        "    hamiltonian = mapper.map(problem.second_q_ops()[0])\n",
        "    num_particles = problem.num_particles\n",
        "    num_spatial_orbitals = problem.num_spatial_orbitals\n",
        "\n",
        "    # 1. Exact Diagonalization Baseline (FCI benchmark within active space)\n",
        "    exact_solver = NumPyMinimumEigensolver()\n",
