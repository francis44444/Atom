        "\n",
        "# 1. Define Pauli basis for 2-qubit tomography (15 operators + Identity)\n",
        "pauli_ops = {\n",
        "    \"II\": qml.Identity(0) @ qml.Identity(1),\n",
        "    \"IX\": qml.Identity(0) @ qml.PauliX(1),\n",
        "    \"IY\": qml.Identity(0) @ qml.PauliY(1),\n",
        "    \"IZ\": qml.Identity(0) @ qml.PauliZ(1),\n",
        "    \"XI\": qml.PauliX(0) @ qml.Identity(1),\n",
        "    \"XX\": qml.PauliX(0) @ qml.PauliX(1),\n",
        "    \"XY\": qml.PauliX(0) @ qml.PauliY(1),\n",
        "    \"XZ\": qml.PauliX(0) @ qml.PauliZ(1),\n",
        "    \"YI\": qml.PauliY(0) @ qml.Identity(1),\n",
        "    \"YX\": qml.PauliY(0) @ qml.PauliX(1),\n",
        "    \"YY\": qml.PauliY(0) @ qml.PauliY(1),\n",
        "    \"YZ\": qml.PauliY(0) @ qml.PauliZ(1),\n",
        "    \"ZI\": qml.PauliZ(0) @ qml.Identity(1),\n",
        "    \"ZX\": qml.PauliZ(0) @ qml.PauliX(1),\n",
        "    \"ZY\": qml.PauliZ(0) @ qml.PauliY(1),\n",
        "    \"ZZ\": qml.PauliZ(0) @ qml.PauliZ(1)\n",
