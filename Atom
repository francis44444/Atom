        "!pip install -q qiskit qiskit-ionq\n",
        "\n",
        "import os\n",
        "import json\n",
        "import numpy as np\n",
        "from getpass import getpass\n",
        "from qiskit import QuantumCircuit, transpile\n",
        "from qiskit_ionq import IonQProvider\n",
        "\n",
        "\"\"\"\n",
        "ionq_real_data_engine.py\n",
        "Module 0 & 1: Native IonQ Calibration, SPAM Inversion Math & QPU Scraper\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 1. AUTHENTICATION & BACKEND SETUP\n",
        "# =====================================================================\n",
        "if not os.getenv(\"IONQ_API_KEY\"):\n",
        "    os.environ[\"IONQ_API_KEY\"] = getpass(\"Enter IonQ API Key: \")\n",
        "\n",
        "provider = IonQProvider(token=os.environ[\"IONQ_API_KEY\"])\n",
        "\n",
        "# Targets: 'ionq_simulator', 'ionq_qpu.aria-1', 'ionq_qpu.forte-1'\n",
        "SIM_BACKEND = provider.get_backend(\"ionq_simulator\")\n",
        "# To run against real QPU, ensure you have allocated credits/access\n",
        "QPU_TARGET_NAME = os.getenv(\"IONQ_TARGET\", \"ionq_simulator\")\n",
        "QPU_BACKEND = provider.get_backend(QPU_TARGET_NAME)\n",
        "\n",
        "SHOTS = 10000\n",
        "H_CORE = -0.46658188  # STO-3G 1-Qubit Hydrogen ground truth (Ha)\n",
        "\n",
        "# =====================================================================\n",
        "# 2. CALIBRATION & INVERSION CLASS\n",
        "# =====================================================================\n",
        "class IonQDataScraperEngine:\n",
        "    def __init__(self, backend, shots=SHOTS):\n",
        "        self.backend = backend\n",
        "        self.shots = shots\n",
        "        self.backend_name = backend.name\n",
        "\n",
        "    def run_spam_calibration(self) -> np.ndarray:\n",
        "        \"\"\"\n",
        "        Executes basis state preparations (|0> and |1>) to construct\n",
        "        the 2x2 readout assignment matrix M.\n",
        "        \"\"\"\n",
        "        print(f\"\\n[Calibrating SPAM on {self.backend_name}]...\")\n",
        "\n",
        "        # Circuit 0: Prepare |0>\n",
        "        qc0 = QuantumCircuit(1, 1)\n",
        "        qc0.measure(0, 0)\n",
        "\n",
        "        # Circuit 1: Prepare |1>\n",
        "        qc1 = QuantumCircuit(1, 1)\n",
        "        qc1.x(0)\n",
        "        qc1.measure(0, 0)\n",
        "\n",
        "        # Dispatch jobs\n",
        "        job0 = self.backend.run(transpile(qc0, self.backend), shots=self.shots)\n",
        "        job1 = self.backend.run(transpile(qc1, self.backend), shots=self.shots)\n",
        "\n",
        "        counts0 = job0.result().get_counts()\n",
        "        counts1 = job1.result().get_counts()\n",
        "\n",
        "        # Parse probabilities\n",
        "        p0_given_0 = counts0.get('0', 0) / self.shots\n",
        "        p1_given_0 = counts0.get('1', 0) / self.shots\n",
        "\n",
        "        p0_given_1 = counts1.get('0', 0) / self.shots\n",
        "        p1_given_1 = counts1.get('1', 0) / self.shots\n",
        "\n",
        "        # Construct assignment matrix M\n",
        "        M = np.array([\n",
        "            [p0_given_0, p0_given_1],\n",
        "            [p1_given_0, p1_given_1]\n",
        "        ])\n",
        "\n",
        "        print(f\"  • M Matrix:\\n{np.array2string(M, prefix='    ')}\")\n",
        "        return M\n",
        "\n",
        "    def run_module1_hydrogen(self, theta_opt: float, M_matrix: np.ndarray) -> dict:\n",
        "        \"\"\"\n",
        "        Runs the VQE circuit at theta_opt, extracts raw counts, and\n",
        "        inverts M to obtain exact mitigated energy.\n",
        "        \"\"\"\n",
        "        print(f\"\\n[Evaluating Module 1 VQE on {self.backend_name}]...\")\n",
        "\n",
        "        qc = QuantumCircuit(1, 1)\n",
        "        qc.ry(theta_opt, 0)\n",
        "        qc.measure(0, 0)\n",
        "\n",
        "        job = self.backend.run(transpile(qc, self.backend), shots=self.shots)\n",
        "        counts = job.result().get_counts()\n",
        "\n",
        "        p0_raw = counts.get('0', 0) / self.shots\n",
        "        p1_raw = counts.get('1', 0) / self.shots\n",
        "        P_raw = np.array([p0_raw, p1_raw])\n",
        "\n",
        "        # Mathematical Inversion: P_corrected = M^-1 * P_raw\n",
        "        M_inv = np.linalg.inv(M_matrix)\n",
        "        P_corrected = M_inv @ P_raw\n",
        "\n",
        "        # Physical boundary clipping to [0, 1]\n",
        "        P_corrected = np.clip(P_corrected, 0.0, 1.0)\n",
        "        P_corrected /= np.sum(P_corrected)\n",
        "\n",
        "        # Raw vs Mitigated Expectation Values\n",
        "        expval_raw = P_raw[0] - P_raw[1]\n",
        "        expval_mitigated = P_corrected[0] - P_corrected[1]\n",
        "\n",
        "        # Compute Energies\n",
        "        c0 = H_CORE / 2.0\n",
        "        c1 = -H_CORE / 2.0\n",
        "\n",
        "        e_raw = c0 + c1 * expval_raw\n",
        "        e_mitigated = c0 + c1 * expval_mitigated\n",
        "\n",
        "        return {\n",
        "            \"backend\": self.backend_name,\n",
        "            \"raw_counts\": counts,\n",
        "            \"P_raw\": P_raw.tolist(),\n",
        "            \"P_corrected\": P_corrected.tolist(),\n",
        "            \"expval_Z_raw\": float(expval_raw),\n",
        "            \"expval_Z_mitigated\": float(expval_mitigated),\n",
        "            \"E_raw_Ha\": float(e_raw),\n",
        "            \"E_mitigated_Ha\": float(e_mitigated),\n",
        "            \"E_exact_Ha\": H_CORE,\n",
        "            \"delta_raw_Ha\": abs(float(e_raw - H_CORE)),\n",
        "            \"delta_mitigated_Ha\": abs(float(e_mitigated - H_CORE)),\n",
        "            \"passed_chemical_accuracy\": abs(float(e_mitigated - H_CORE)) < 0.001594\n",
        "        }\n",
        "\n",
        "# =====================================================================\n",
        "# 3. COMPARATIVE EXECUTION (SIMULATOR VS TARGET QPU)\n",
        "# =====================================================================\n",
        "def main():\n",
        "    theta_optimal = np.pi  # Theoretical ground-state rotation for H-core\n",
        "\n",
        "    # 1. Run Simulator Track\n",
        "    sim_engine = IonQDataScraperEngine(SIM_BACKEND, shots=SHOTS)\n",
        "    M_sim = sim_engine.run_spam_calibration()\n",
        "    res_sim = sim_engine.run_module1_hydrogen(theta_optimal, M_sim)\n",
        "\n",
        "    # 2. Run QPU / Hardware Track\n",
        "    qpu_engine = IonQDataScraperEngine(QPU_BACKEND, shots=SHOTS)\n",
        "    M_qpu = qpu_engine.run_spam_calibration()\n",
        "    res_qpu = qpu_engine.run_module1_hydrogen(theta_optimal, M_qpu)\n",
        "\n",
        "    # 3. Print Output Summary Table\n",
        "    print(\"\\n\" + \"=\" * 80)\n",
        "    print(\"IONQ QUANTUM DATA SCRAPER & BENCHMARK SUMMARY\")\n",
        "    print(\"=\" * 80)\n",
        "    print(f\"{'Metric':<30} | {'Simulator (' + res_sim['backend'] + ')':<20} | {'Hardware (' + res_qpu['backend'] + ')'}\")\n",
        "    print(\"-\" * 80)\n",
        "    print(f\"{'Raw Counts |0>':<30} | {res_sim['raw_counts'].get('0', 0):<20} | {res_qpu['raw_counts'].get('0', 0)}\")\n",
        "    print(f\"{'Raw Counts |1>':<30} | {res_sim['raw_counts'].get('1', 0):<20} | {res_qpu['raw_counts'].get('1', 0)}\")\n",
        "    print(f\"{'Raw <Z>':<30} | {res_sim['expval_Z_raw']:<20.5f} | {res_qpu['expval_Z_raw']:<20.5f}\")\n",
        "    print(f\"{'Mitigated <Z>':<30} | {res_sim['expval_Z_mitigated']:<20.5f} | {res_qpu['expval_Z_mitigated']:<20.5f}\")\n",
        "    print(f\"{'Mitigated Energy (Ha)':<30} | {res_sim['E_mitigated_Ha']:<20.8f} | {res_qpu['E_mitigated_Ha']:<20.8f}\")\n",
        "    print(f\"{'Chemical Accuracy (Δ < 1.6mHa)':<30} | {str(res_sim['passed_chemical_accuracy']):<20} | {str(res_qpu['passed_chemical_accuracy'])}\")\n",
        "    print(\"=\" * 80)\n",
        "\n",
        "    # 4. Save Raw Output JSON\n",
        "    output_payload = {\n",
        "        \"simulator_run\": res_sim,\n",
        "        \"hardware_run\": res_qpu\n",
        "    }\n",
        "    with open(\"ionq_real_data_results.json\", \"w\") as f:\n",
        "        json.dump(output_payload, f, indent=2)\n",
        "    print(\"✅ Full telemetry and inversion mathematics saved to 'ionq_real_data_results.json'.\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    },
