        "\n",
        "class AutonomousQuantumAgent:\n",
        "    def __init__(self, fallback_to_sim=True):\n",
        "        self.fallback_to_sim = fallback_to_sim\n",
        "        self.api_key = self._intercept_credentials()\n",
        "        self.provider = None\n",
        "        self.backend = None\n",
        "        self.backend_type = \"LOCAL_AER\"\n",
        "        self._configure_routing()\n",
        "\n",
        "    def _intercept_credentials(self):\n",
        "        \"\"\"Scans environment and Colab secrets without prompting the user.\"\"\"\n",
        "        candidate_keys = ['IONQ_API_KEY', 'ionq', 'ionq2', 'ionq_3', 'forte', 'aria1']\n",
        "\n",
        "        # 1. Check Colab Secrets Vault\n",
        "        try:\n",
        "            from google.colab import userdata\n",
        "            for k in candidate_keys:\n",
        "                try:\n",
        "                    val = userdata.get(k)\n",
        "                    if val and len(str(val).strip()) > 5:\n",
        "                        return str(val).strip()\n",
        "                except Exception:\n",
        "                    continue\n",
        "        except ImportError:\n",
        "            pass\n",
        "\n",
        "        # 2. Check System Environment\n",
        "        for k in candidate_keys:\n",
        "            val = os.getenv(k)\n",
        "            if val and len(val.strip()) > 5:\n",
        "                return val.strip()\n",
        "\n",
        "        return None\n",
        "\n",
        "    def _configure_routing(self):\n",
        "        \"\"\"Maps backend automatically based on available credentials.\"\"\"\n",
        "        if self.api_key:\n",
        "            try:\n",
        "                from qiskit_ionq import IonQProvider\n",
        "                self.provider = IonQProvider(token=self.api_key)\n",
        "                available = [b.name() for b in self.provider.backends()]\n",
        "\n",
        "                # Priority: Aria -> Forte -> General QPU -> Cloud Simulator\n",
        "                targets = [\"qpu.aria-1\", \"ionq_qpu.aria-1\", \"qpu.forte-1\", \"ionq_qpu.forte-1\", \"ionq_qpu\", \"ionq_simulator\", \"simulator\"]\n",
        "                for target in targets:\n",
        "                    if target in available:\n",
        "                        self.backend = self.provider.get_backend(target)\n",
        "                        self.backend_type = \"IONQ_QPU\" if \"qpu\" in target else \"IONQ_SIM\"\n",
        "                        print(f\"[Agent Status] Routed to remote target: {self.backend.name()} ({self.backend_type})\")\n",
