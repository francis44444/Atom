        "            except Exception as e:\n",
        "                print(f\"[Agent Warning] Cloud handshake failed: {e}. Intercepting route...\")\n",
        "\n",
        "        # Fallback Map\n",
        "        if self.fallback_to_sim:\n",
        "            self.backend = AerSimulator()\n",
        "            self.backend_type = \"LOCAL_AER\"\n",
        "            print(\"[Agent Status] Routed to Local Math Engine (AerSimulator).\")\n",
        "        else:\n",
