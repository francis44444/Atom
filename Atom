        "# =====================================================================\n",
        "# IONQ FORTE — HARDWARE SUBMISSION (clean, single-purpose)\n",
        "# =====================================================================\n",
        "#\n",
        "# What this does:\n",
        "#   1. Loads your IonQ API key from Colab Secrets (never hardcoded)\n",
        "#   2. Connects specifically to the Forte QPU (falls back to sim if unavailable)\n",
        "#   3. Runs a Bell-state circuit as a sanity check\n",
        "#   4. Polls until the hardware job finishes\n",
        "#   5. Returns raw counts + per-shot memory\n",
        "#\n",
        "# Prerequisite: In Colab, click the 🔑 (Secrets) icon on the left sidebar,\n",
        "# add a secret named IONQ_API_KEY, paste your key, and enable notebook access.\n",
        "# =====================================================================\n",
        "\n",
        "!pip install -q \"qiskit>=2.0\" \"qiskit-ionq>=1.1.1\" qiskit-aer\n",
        "\n",
        "import time\n",
        "from google.colab import userdata\n",
        "from qiskit import QuantumCircuit, transpile\n",
        "from qiskit_ionq import IonQProvider\n",
        "from qiskit_aer import AerSimulator\n",
        "\n",
        "SHOTS = 1000\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# 1. Secure API key retrieval\n",
        "# ---------------------------------------------------------------------\n",
        "try:\n",
        "    api_key = userdata.get(\"IONQ_API_KEY\")\n",
        "except Exception as e:\n",
        "    raise RuntimeError(\n",
        "        \"Could not read 'IONQ_API_KEY' from Colab Secrets. \"\n",
        "        \"Add it via the 🔑 icon and enable notebook access.\"\n",
        "    ) from e\n",
        "\n",
        "provider = IonQProvider(token=api_key)\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# 2. Target the Forte QPU specifically (fallback to Aer if unavailable)\n",
        "# ---------------------------------------------------------------------\n",
        "def get_forte_backend(provider):\n",
        "    try:\n",
        "        available = [b.name for b in provider.backends()]\n",
        "    except Exception as e:\n",
        "        print(f\"⚠ Could not list IonQ backends: {e}\")\n",
        "        available = []\n",
        "\n",
        "    print(\"Backends visible to your account:\", available)\n",
        "\n",
        "    for target in [\"qpu.forte-1\", \"ionq_qpu.forte-1\", \"ionq_qpu.forte-enterprise-1\"]:\n",
        "        if target in available:\n",
        "            print(f\"🎯 Targeting: {target}\")\n",
        "            return provider.get_backend(target), True\n",
        "\n",
        "    print(\"⚠ Forte not available on your account — falling back to local AerSimulator.\")\n",
        "    return AerSimulator(), False\n",
        "\n",
        "backend, is_real_qpu = get_forte_backend(provider)\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# 3. Circuit: Bell state (sanity-check entanglement)\n",
        "# ---------------------------------------------------------------------\n",
        "qc = QuantumCircuit(2, 2, name=\"Forte_Bell_Test\")\n",
        "qc.h(0)\n",
        "qc.cx(0, 1)\n",
        "qc.measure([0, 1], [0, 1])\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# 4. Transpile and submit\n",
        "# ---------------------------------------------------------------------\n",
        "transpiled = transpile(qc, backend, optimization_level=1)\n",
        "\n",
        "print(f\"\\n🚀 Submitting job to {getattr(backend, 'name', 'AerSimulator')} ({SHOTS} shots)...\")\n",
        "\n",
        "if is_real_qpu:\n",
        "    job = backend.run(transpiled, shots=SHOTS, debiasing=True, memory=True)\n",
        "    job_id = job.job_id()\n",
        "    print(f\"🆔 Job ID: {job_id}  (save this — you can retrieve results later, see below)\")\n",
        "\n",
        "    with open(\"active_ionq_job.txt\", \"w\") as f:\n",
        "        f.write(job_id)\n",
        "\n",
        "    print(\"⏳ Waiting for hardware queue...\")\n",
        "    while not job.done():\n",
        "        status = job.status()\n",
        "        print(f\"  status: {status.name} — polling again in 20s\")\n",
        "        time.sleep(20)\n",
        "else:\n",
        "    job = backend.run(transpiled, shots=SHOTS, memory=True)\n",
        "\n",
        "# ---------------------------------------------------------------------\n",
        "# 5. Raw results\n",
        "# ---------------------------------------------------------------------\n",
        "result = job.result()\n",
        "counts = result.get_counts()\n",
        "memory = job.get_memory() if hasattr(job, \"get_memory\") else []\n",
        "\n",
        "print(\"\\n\" + \"=\" * 50)\n",
        "print(\"RAW RESULTS\")\n",
        "print(\"=\" * 50)\n",
        "print(\"Backend:\", getattr(backend, \"name\", \"AerSimulator\"))\n",
        "print(\"Counts:\", counts)\n",
        "print(\"First 10 shots:\", memory[:10])\n",
